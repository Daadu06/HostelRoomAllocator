                </div>
            </form>
        </div>
    </div>

    <!-- ═══════════ COMPLAINT MODAL ═══════════ -->
    <div class="modal-overlay" id="complaintModal">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h3 style="display:flex;align-items:center;">
                        <div class="modal-icon-bg error">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2">
                                <path
                                    d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                                <line x1="12" y1="9" x2="12" y2="13" />
                                <line x1="12" y1="17" x2="12.01" y2="17" />
                            </svg>
                        </div>
                        Report an Issue
                    </h3>
                    <div style="font-size:0.85rem;color:var(--slate-500);margin-top:0.25rem;margin-left:3.2rem;">Help us
                        resolve your concern quickly.</div>
                </div>
                <button class="modal-close" style="align-self:flex-start;"
                    onclick="document.getElementById('complaintModal').classList.remove('active'); document.body.classList.remove('scroll-locked');">&times;</button>
            </div>
            <form action="/student/complaint" method="POST">
                <div class="modal-body">
                    <div class="modal-input-wrapper">
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label">Complaint Type <span style="color:var(--error);">*</span></label>
                            <select name="complaint_type" class="form-control" required>
                                <option value="">Select type...</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Roommate Issue">Roommate Issue</option>
                                <option value="Electrical">Electrical</option>
                                <option value="Plumbing">Plumbing</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-input-wrapper" style="margin-bottom:0;">
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label">Description <span style="color:var(--error);">*</span></label>
                            <textarea name="description" class="form-control" rows="5"
                                placeholder="Describe the issue in detail..." required maxlength="1000"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline btn-sm"
                        onclick="document.getElementById('complaintModal').classList.remove('active'); document.body.classList.remove('scroll-locked');">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Submit Complaint</button>
