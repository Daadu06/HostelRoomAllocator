                    </h3>
                    <div class="modal-subtitle">Submit a formal transfer request to administration.</div>
                </div>
                <button class="modal-close" style="align-self:flex-start;"
                    onclick="document.getElementById('reallocationModal').classList.remove('active'); document.body.classList.remove('scroll-locked');">&times;</button>
            </div>
