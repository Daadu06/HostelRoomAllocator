                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                    Roommates
                                </div>
                                <div style="font-size:0.95rem;font-weight:600;color:var(--slate-700);">
                                    <%= roommates.map(r=> r.full_name).join(', ') || 'None' %>
                                </div>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:0.25rem;">
                                <div
                                    style="color:var(--slate-500);font-size:0.8rem;display:flex;align-items:center;gap:0.375rem;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    Allocated Date
                                </div>
                                <div style="font-size:0.95rem;font-weight:600;color:var(--slate-700);">
                                    <%= new Date(allocation.allocated_at).toLocaleDateString() %>
                                </div>
                            </div>
                        </div>
                        <% } %>

                            <div class="form-group" style="margin-bottom:1.25rem;">
                                <label class="form-label" style="margin-bottom:0.5rem;">Reason for Request <span
                                        style="color:var(--error);">*</span></label>
                                <select name="reason" class="form-control" style="border-radius:var(--radius-md);"
                                    required>
                                    <option value="">Select a reason...</option>
                                    <option value="Conflict with roommate">Conflict with roommate</option>
                                    <option value="Health issue">Health issue</option>
                                    <option value="Study preference mismatch">Study preference mismatch</option>
                                    <option value="Personal reason">Personal reason</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="form-group" style="margin-bottom:0;">
                                <label class="form-label" style="margin-bottom:0.5rem;">Additional Comments</label>
                                <textarea name="comments" class="form-control" rows="3"
                                    style="border-radius:var(--radius-md);"
                                    placeholder="Provide any additional details..." maxlength="500"></textarea>
                            </div>
                            <div class="modal-alert-box">
                                <div
                                    style="background:#FDE68A;color:#B45309;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2">
                                        <path
                                            d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                                        <line x1="12" y1="9" x2="12" y2="13" />
                                        <line x1="12" y1="17" x2="12.01" y2="17" />
                                    </svg>
                                </div>
                                <div>
                                    <strong
                                        style="font-weight:600;color:#92400e;display:block;margin-bottom:0.15rem;">Admin
                                        Review Required:</strong> <span style="font-size:0.85rem;">Reallocation requests
                                        will be reviewed by
                                        administration. Approval is not guaranteed and
                                        may take several business days.</span>
                                </div>
                            </div>
                </div>
                <div class="modal-footer"
                    style="padding:1.25rem 1.5rem;background:white;border-top:1px solid var(--slate-100);">
                    <button type="button" class="btn btn-outline btn-sm"
                        style="border-color:var(--slate-200);color:var(--slate-600);"
                        onclick="document.getElementById('reallocationModal').classList.remove('active'); document.body.classList.remove('scroll-locked');">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm"
                        style="box-shadow:0 4px 12px rgba(79,70,229,0.3);padding:0.5rem 1.25rem;">Submit
