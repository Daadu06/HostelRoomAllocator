<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Allocation - Admin Panel</title>
    <link rel="stylesheet" href="/css/style.css?v=4">
</head>

<body>
    <div class="app-layout">
        <%- include('partials/sidebar') %>

            <main class="main-content">
                <div class="content-header">
                    <div>
                        <h1>Room Allocation</h1>
                        <div class="header-subtitle">Manage the automatic room assignment process</div>
                    </div>
                </div>

                <div class="content-body">
                    <% if (success) { %>
                        <div class="alert alert-success">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                <polyline points="22 4 12 14.01 9 11.01" />
                            </svg>
                            <%= success %>
                        </div>
                        <% } %>
                            <% if (error) { %>
                                <div class="alert alert-danger">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10" />
                                        <line x1="15" y1="9" x2="9" y2="15" />
                                        <line x1="9" y1="9" x2="15" y2="15" />
                                    </svg>
                                    <%= error %>
                                </div>
                                <% } %>

                                    <!-- Status Summary -->
                                    <div class="stats-grid">
                                        <div class="stat-card green">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Already Allocated</div>
                                                    <div class="stat-value">
                                                        <%= stats.allocatedStudents %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                                        <polyline points="22 4 12 14.01 9 11.01" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card yellow">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Pending Assignment</div>
                                                    <div class="stat-value">
                                                        <%= stats.pendingStudents %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="12" cy="12" r="10" />
                                                        <polyline points="12 6 12 12 16 14" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card purple">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Avg Compatibility</div>
                                                    <div class="stat-value">
                                                        <%= stats.avgCompatibility %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <polygon
                                                            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card blue">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Occupancy Rate</div>
                                                    <div class="stat-value">
                                                        <%= stats.occupancyRate %>%
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <line x1="18" y1="20" x2="18" y2="10" />
                                                        <line x1="12" y1="20" x2="12" y2="4" />
                                                        <line x1="6" y1="20" x2="6" y2="14" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Allocation Controls -->
                                    <div class="grid-2">
                                        <div class="card">
                                            <div class="card-header">
                                                <h3>
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2" style="vertical-align:-4px;">
                                                        <polygon points="5 3 19 12 5 21 5 3" />
                                                    </svg>
                                                    Run Allocation
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <p
                                                    style="margin-bottom:1rem; color:var(--slate-600); font-size:0.9rem;">
                                                    The greedy allocation algorithm will assign <strong>
                                                        <%= stats.pendingStudents %> pending students
                                                    </strong>
                                                    to available rooms based on their compatibility scores.
                                                </p>
                                                <div class="detail-item">
                                                    <span class="detail-label">Algorithm</span>
                                                    <span class="pref-tag">Greedy Compatibility Matching</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-label">Scoring Factors</span>
                                                    <span class="detail-value">Sleep pattern, study style, noise,
                                                        cleanliness</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-label">Conflict Handling</span>
                                                    <span class="detail-value">Conflict lists + preferred roommate
                                                        priority</span>
                                                </div>
                                                <form action="/admin/allocate" method="POST" style="margin-top:1.5rem;">
                                                    <button type="submit" class="btn btn-success btn-block"
                                                        onclick="return confirm('Run allocation algorithm? This will assign pending students to available rooms.')"
                                                        <%=stats.pendingStudents===0 ? 'disabled' : '' %>>
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2"
                                                            style="vertical-align:-3px; margin-right:6px;">
                                                            <polygon points="5 3 19 12 5 21 5 3" />
                                                        </svg>
                                                        Allocate <%= stats.pendingStudents %> Students
                                                    </button>
                                                </form>
                                            </div>
                                        </div>

                                        <div class="card">
                                            <div class="card-header">
                                                <h3>
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2" style="vertical-align:-4px;">
                                                        <polyline points="1 4 1 10 7 10" />
                                                        <polyline points="23 20 23 14 17 14" />
                                                        <path
                                                            d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15" />
                                                    </svg>
                                                    Reset Allocations
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <p
                                                    style="margin-bottom:1rem; color:var(--slate-600); font-size:0.9rem;">
                                                    Remove <strong>all existing allocations</strong>. This will unassign
                                                    every student from their room
                                                    and reset all room occupancies to zero.
                                                </p>
                                                <div class="alert alert-danger" style="margin-top:1rem;">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2">
                                                        <path
                                                            d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                                                        <line x1="12" y1="9" x2="12" y2="13" />
                                                        <line x1="12" y1="17" x2="12.01" y2="17" />
                                                    </svg>
                                                    This action cannot be undone.
                                                </div>
                                                <form action="/admin/reset-allocation" method="POST"
                                                    style="margin-top:1.5rem;">
                                                    <button type="submit" class="btn btn-danger btn-block"
                                                        onclick="return confirm('⚠️ WARNING: This will remove ALL allocations and reset all room occupancies. This cannot be undone. Continue?')"
                                                        <%=stats.allocatedStudents===0 ? 'disabled' : '' %>>
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2"
                                                            style="vertical-align:-3px; margin-right:6px;">
                                                            <polyline points="3 6 5 6 21 6" />
                                                            <path
                                                                d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                                        </svg>
                                                        Reset All Allocations (<%= stats.allocatedStudents %>)
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Current Allocation Map -->
                                    <% if (allocations.length> 0) { %>
                                        <div class="card" style="margin-top:1.5rem;">
                                            <div class="card-header">
                                                <h3>Current Allocation Map</h3>
                                                <span class="badge badge-primary">
                                                    <%= allocations.length %> assignments
                                                </span>
                                            </div>
                                            <div class="table-container">
                                                <table class="data-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Room</th>
                                                            <th>Student ID</th>
                                                            <th>Student Name</th>
                                                            <th>Department</th>
                                                            <th>Compatibility</th>
                                                            <th>Allocated At</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% allocations.forEach(function(a) { %>
                                                            <tr>
                                                                <td><strong>
                                                                        <%= a.room_number %>
                                                                    </strong></td>
                                                                <td>
                                                                    <%= a.student_id %>
                                                                </td>
                                                                <td>
                                                                    <%= a.full_name %>
                                                                </td>
                                                                <td>
                                                                    <%= a.department %>
                                                                </td>
                                                                <td>
                                                                    <span
                                                                        class="badge <%= a.compatibility_score >= 7 ? 'badge-success' : a.compatibility_score >= 4 ? 'badge-warning' : 'badge-danger' %>">
                                                                        <%= a.compatibility_score !=null ?
                                                                            a.compatibility_score.toFixed(1) : '0.0' %>
                                                                    </span>
                                                                </td>
                                                                <td class="text-sm text-muted">
                                                                    <%= new
                                                                        Date(a.allocated_at).toLocaleDateString('en-IN',
                                                                        {day:'numeric', month:'short', year:'numeric'})
                                                                        %>
                                                                </td>
                                                            </tr>
                                                            <% }); %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <% } %>
                </div>
            </main>
    </div>
</body>

</html>
