<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fee Management - Admin Panel</title>
    <meta name="description" content="Manage hostel fee records for all students.">
    <link rel="stylesheet" href="/css/style.css?v=5">
</head>

<body>
    <div class="app-layout">
        <%- include('partials/sidebar') %>
            <main class="main-content">
                <div class="content-header">
                    <div>
                        <h1>Fee Management</h1>
                        <div class="header-subtitle">Track and manage hostel fee payments</div>
                    </div>
                </div>
                <div class="content-body">
                    <% if (success) { %>
                        <div class="alert alert-success"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                <polyline points="22 4 12 14.01 9 11.01" />
                            </svg>
                            <%= success %>
                        </div>
                        <% } %>

                            <!-- Fee Summary -->
                            <div class="stats-grid"
                                style="grid-template-columns: repeat(auto-fit,minmax(200px,1fr));margin-bottom:1.5rem;">
                                <div class="stat-card green">
                                    <div class="stat-header">
                                        <div>
                                            <div class="stat-label">Total Collected</div>
                                            <div class="stat-value">₹<%= totalCollected.toLocaleString() %>
                                            </div>
                                        </div>
                                        <div class="stat-icon"><svg xmlns="http://www.w3.org/2000/svg"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <line x1="12" y1="1" x2="12" y2="23" />
                                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                            </svg></div>
                                    </div>
                                </div>
                                <div class="stat-card red">
                                    <div class="stat-header">
                                        <div>
                                            <div class="stat-label">Total Due</div>
                                            <div class="stat-value">₹<%= totalDue.toLocaleString() %>
                                            </div>
                                        </div>
                                        <div class="stat-icon"><svg xmlns="http://www.w3.org/2000/svg"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10" />
                                                <polyline points="12 6 12 12 16 14" />
                                            </svg></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Bulk Update -->
                            <div class="card" style="margin-bottom:1.5rem;">
                                <div class="card-header">
                                    <h3>Set Fee for All Students</h3>
                                </div>
                                <div class="card-body">
                                    <form action="/admin/fees/set-all" method="POST"
                                        style="display:flex;gap:1rem;align-items:flex-end;flex-wrap:wrap;">
                                        <div class="form-group" style="margin:0;flex:1;min-width:180px;">
                                            <label class="form-label" style="margin-bottom:0.25rem;">Total Amount
                                                (₹)</label>
                                            <input type="number" name="total_amount" class="form-control"
                                                value="<%= globalFee ? globalFee.total_amount : '' %>" min="0"
                                                step="100" placeholder="Enter amount" required>
                                        </div>
                                        <div class="form-group" style="margin:0;flex:1;min-width:180px;">
                                            <label class="form-label" style="margin-bottom:0.25rem;">Due Date</label>
                                            <input type="date" name="due_date" class="form-control"
                                                value="<%= globalFee ? globalFee.due_date : '' %>" required>
                                        </div>
                                        <button type="submit" class="btn btn-primary"
                                            onclick="return confirm('Update fee amount for all students?')">Update
                                            All</button>
                                    </form>
                                </div>
                            </div>

                            <!-- Individual Records -->
                            <div class="card">
                                <div class="card-header">
                                    <h3>Student Fee Records</h3>
                                </div>
                                <div class="card-body">
                                    <div class="table-container"
                                        style="max-height:300px;overflow-y:auto;overflow-x:hidden;">
                                        <table class="data-table">
                                            <thead>
                                                <tr>
                                                    <th>Student</th>
                                                    <th>Department</th>
                                                    <th>Total</th>
                                                    <th>Paid</th>
                                                    <th>Balance</th>
                                                    <th>Due Date</th>
                                                    <th>Status</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% for (const f of feeRecords) { %>
                                                    <tr>
                                                        <td><strong>
                                                                <%= f.full_name %>
                                                            </strong><br><small class="text-muted">
                                                                <%= f.student_id %>
                                                            </small></td>
                                                        <td>
                                                            <%= f.department %>
                                                        </td>
                                                        <td>₹<%= f.total_amount.toLocaleString() %>
                                                        </td>
                                                        <td>₹<%= f.amount_paid.toLocaleString() %>
                                                        </td>
                                                        <td
                                                            style="font-weight:600;color:<%= (f.total_amount - f.amount_paid) > 0 ? 'var(--error)' : 'var(--success)' %>;">
                                                            ₹<%= (f.total_amount - f.amount_paid).toLocaleString() %>
                                                        </td>
                                                        <td><small>
                                                                <%= f.due_date %>
                                                            </small></td>
                                                        <td><span
                                                                class="badge <%= f.status === 'Paid' ? 'badge-success' : f.status === 'Overdue' ? 'badge-danger' : 'badge-warning' %>">
                                                                <%= f.status %>
                                                            </span></td>
                                                        <td>
                                                            <form action="/admin/fees/<%= f.id %>/update" method="POST"
                                                                style="display:flex;flex-direction:column;gap:0.375rem;">
                                                                <div style="display:flex;gap:0.25rem;">
                                                                    <input type="number" name="total_amount"
                                                                        value="<%= f.total_amount %>"
                                                                        class="form-control"
                                                                        style="font-size:0.75rem;padding:0.25rem 0.4rem;width:80px;"
                                                                        min="0" step="100">
                                                                    <input type="number" name="amount_paid"
                                                                        value="<%= f.amount_paid %>"
                                                                        class="form-control"
                                                                        style="font-size:0.75rem;padding:0.25rem 0.4rem;width:80px;"
                                                                        min="0" step="100">
                                                                </div>
                                                                <div style="display:flex;gap:0.25rem;">
                                                                    <input type="date" name="due_date"
                                                                        value="<%= f.due_date %>" class="form-control"
                                                                        style="font-size:0.75rem;padding:0.25rem 0.4rem;flex:1;">
                                                                    <select name="status" class="form-control"
                                                                        style="font-size:0.75rem;padding:0.25rem 0.4rem;">
                                                                        <option value="Pending" <%=f.status==='Pending'
                                                                            ? 'selected' : '' %>>Pending</option>
                                                                        <option value="Paid" <%=f.status==='Paid'
                                                                            ? 'selected' : '' %>>Paid</option>
                                                                        <option value="Overdue" <%=f.status==='Overdue'
                                                                            ? 'selected' : '' %>>Overdue</option>
                                                                    </select>
                                                                </div>
                                                                <button type="submit"
                                                                    class="btn btn-primary btn-sm">Save</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                    <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Payment History -->
                            <div class="card" style="margin-top:2rem;">
                                <div class="card-header">
                                    <h3>Payment History</h3>
                                </div>
                                <div class="card-body" style="padding:0;">
                                    <div class="table-responsive"
                                        style="max-height:400px;overflow-y:auto;overflow-x:hidden;">
                                        <table class="data-table">
                                            <thead>
                                                <tr>
                                                    <th>Student</th>
                                                    <th>Amount</th>
                                                    <th>Status</th>
                                                    <th>Transaction ID / Order ID</th>
                                                    <th>Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (paymentHistory && paymentHistory.length> 0) { %>
                                                    <% for (const p of paymentHistory) { %>
                                                        <tr>
                                                            <td><strong>
                                                                    <%= p.full_name %>
                                                                </strong><br><small class="text-muted">
                                                                    <%= p.student_id %>
                                                                </small></td>
                                                            <td style="font-weight:600;">₹<%= p.amount.toLocaleString()
                                                                    %>
                                                            </td>
                                                            <td>
                                                                <span
                                                                    class="badge <%= p.status === 'Success' ? 'badge-success' : p.status === 'Failed' ? 'badge-danger' : 'badge-warning' %>">
                                                                    <%= p.status %>
                                                                </span>
                                                            </td>
                                                            <td><small
                                                                    style="font-family:monospace;color:var(--slate-500);">
                                                                    <%= p.payment_id || p.order_id %>
                                                                </small></td>
                                                            <td><small>
                                                                    <%= new Date(p.created_at + ' UTC'
                                                                        ).toLocaleString('en-IN', {
                                                                        timeZone: 'Asia/Kolkata' }) %>
                                                                </small></td>
                                                        </tr>
                                                        <% } %>
                                                            <% } else { %>
                                                                <tr>
                                                                    <td colspan="5"
                                                                        style="text-align:center;padding:2rem;color:var(--slate-400);">
                                                                        No online payment history found.</td>
                                                                </tr>
                                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                </div>
            </main>
    </div>
</body>

</html>