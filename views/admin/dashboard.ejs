<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Smart Hostel</title>
    <meta name="description" content="Admin dashboard overview for Smart Hostel Room Allocation System.">
    <link rel="stylesheet" href="/css/style.css?v=4">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>

<body>
    <div class="app-layout">
        <%- include('partials/sidebar') %>

            <main class="main-content">
                <div class="content-header">
                    <div>
                        <h1>Dashboard Overview</h1>
                        <div class="header-subtitle">System analytics and quick controls</div>
                    </div>
                    <div class="content-header-actions">
                        <a href="/admin/export" class="btn btn-outline btn-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                <polyline points="7 10 12 15 17 10" />
                                <line x1="12" y1="15" x2="12" y2="3" />
                            </svg>
                            Export CSV
                        </a>
                    </div>
                </div>

                <div class="content-body">
                    <% if (success) { %>
                        <div class="alert alert-success">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                <polyline points="22 4 12 14.01 9 11.01" />
                            </svg>
                            <%= success %>
                        </div>
                        <% } %>
                            <% if (error) { %>
                                <div class="alert alert-danger">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10" />
                                        <line x1="15" y1="9" x2="9" y2="15" />
                                        <line x1="9" y1="9" x2="15" y2="15" />
                                    </svg>
                                    <%= error %>
                                </div>
                                <% } %>

                                    <!-- Stats Grid -->
                                    <div class="stats-grid">
                                        <div class="stat-card blue">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Total Students</div>
                                                    <div class="stat-value">
                                                        <%= stats.totalStudents %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                                        <circle cx="9" cy="7" r="4" />
                                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card indigo">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Total Rooms</div>
                                                    <div class="stat-value">
                                                        <%= stats.totalRooms %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                                        <polyline points="9 22 9 12 15 12 15 22" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card green">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Allocated</div>
                                                    <div class="stat-value">
                                                        <%= stats.allocatedStudents %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                                        <polyline points="22 4 12 14.01 9 11.01" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card yellow">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Pending</div>
                                                    <div class="stat-value">
                                                        <%= stats.pendingStudents %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="12" cy="12" r="10" />
                                                        <polyline points="12 6 12 12 16 14" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card purple">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Avg Compatibility</div>
                                                    <div class="stat-value">
                                                        <%= stats.avgCompatibility %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <polygon
                                                            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card red">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Occupancy Rate</div>
                                                    <div class="stat-value">
                                                        <%= stats.occupancyRate %>%
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <line x1="18" y1="20" x2="18" y2="10" />
                                                        <line x1="12" y1="20" x2="12" y2="4" />
                                                        <line x1="6" y1="20" x2="6" y2="14" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Charts Row -->
                                    <div class="grid-2">
                                        <div class="card">
                                            <div class="card-header">
                                                <h3>Department Distribution</h3>
                                            </div>
                                            <div class="card-body"><canvas id="deptChart" height="220"></canvas></div>
                                        </div>
                                        <div class="card">
                                            <div class="card-header">
                                                <h3>Allocation Overview</h3>
                                            </div>
                                            <div class="card-body"><canvas id="allocChart" height="220"></canvas></div>
                                        </div>
                                    </div>

                                    <!-- Quick Actions -->
                                    <div class="control-panel">
                                        <h3>Quick Allocation Controls</h3>
                                        <p>Run the greedy allocation algorithm to assign students to rooms based on
                                            compatibility scoring.</p>
                                        <div class="control-buttons">
                                            <form action="/admin/allocate" method="POST" style="display:inline;">
                                                <button type="submit" class="btn btn-success"
                                                    onclick="return confirm('Run allocation algorithm? This will assign pending students to available rooms.')">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2">
                                                        <polygon points="5 3 19 12 5 21 5 3" />
                                                    </svg>
                                                    Run Allocation
                                                </button>
                                            </form>
                                            <form action="/admin/reset-allocation" method="POST"
                                                style="display:inline;">
                                                <button type="submit" class="btn btn-danger"
                                                    onclick="return confirm('⚠️ This will remove ALL allocations. Are you sure?')">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2">
                                                        <polyline points="1 4 1 10 7 10" />
                                                        <polyline points="23 20 23 14 17 14" />
                                                        <path
                                                            d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15" />
                                                    </svg>
                                                    Reset All
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                </div>
            </main>
    </div>

    <script>
        const deptData = <% - JSON.stringify(departments) %>;
        const allocData = { allocated: <%= stats.allocatedStudents %>, pending: <%= stats.pendingStudents %> };

        if (deptData.length > 0) {
            new Chart(document.getElementById('deptChart'), {
                type: 'bar',
                data: {
                    labels: deptData.map(d => d.department),
                    datasets: [{
                        label: 'Students', data: deptData.map(d => d.count),
                        backgroundColor: ['#6366f1', '#818cf8', '#a5b4fc', '#c7d2fe', '#e0e7ff', '#8b5cf6'],
                        borderRadius: 8, borderSkipped: false
                    }]
                },
                options: {
                    responsive: true, plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f1f5f9' } }, x: { grid: { display: false } } }
                }
            });
        }

        new Chart(document.getElementById('allocChart'), {
            type: 'doughnut',
            data: {
                labels: ['Allocated', 'Pending'],
                datasets: [{
                    data: [allocData.allocated, allocData.pending],
                    backgroundColor: ['#22c55e', '#f59e0b'], borderWidth: 0, hoverOffset: 4
                }]
            },
            options: {
                responsive: true, cutout: '65%',
                plugins: { legend: { position: 'bottom', labels: { padding: 20, usePointStyle: true } } }
            }
        });
    </script>
</body>

</html>
