<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complaints Management - Admin Panel</title>
    <meta name="description" content="Manage student complaints and issues.">
    <link rel="stylesheet" href="/css/style.css?v=5">
</head>

<body>
    <div class="app-layout">
        <%- include('partials/sidebar') %>
            <main class="main-content">
                <div class="content-header">
                    <div>
                        <h1>Complaints Management</h1>
                        <div class="header-subtitle">Review and resolve student complaints</div>
                    </div>
                    <div class="content-header-actions">
                        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                            <a href="/admin/complaints"
                                class="btn btn-sm <%= statusFilter === 'all' ? 'btn-primary' : 'btn-outline' %>">All</a>
                            <a href="/admin/complaints?status=Pending"
                                class="btn btn-sm <%= statusFilter === 'Pending' ? 'btn-primary' : 'btn-outline' %>">Pending</a>
                            <a href="/admin/complaints?status=In Review"
                                class="btn btn-sm <%= statusFilter === 'In Review' ? 'btn-primary' : 'btn-outline' %>">In
                                Review</a>
                            <a href="/admin/complaints?status=Resolved"
                                class="btn btn-sm <%= statusFilter === 'Resolved' ? 'btn-primary' : 'btn-outline' %>">Resolved</a>
                            <a href="/admin/complaints?status=Rejected"
                                class="btn btn-sm <%= statusFilter === 'Rejected' ? 'btn-primary' : 'btn-outline' %>">Rejected</a>
                        </div>
                    </div>
                </div>
                <div class="content-body">
                    <% if (success) { %>
                        <div class="alert alert-success"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                <polyline points="22 4 12 14.01 9 11.01" />
                            </svg>
                            <%= success %>
                        </div>
                        <% } %>

                            <% if (complaints.length===0) { %>
                                <div class="card">
                                    <div class="card-body"
                                        style="text-align:center;padding:3rem;color:var(--slate-400);">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                                            style="opacity:0.3;margin-bottom:1rem;">
                                            <circle cx="12" cy="12" r="10" />
                                            <line x1="12" y1="8" x2="12" y2="12" />
                                            <line x1="12" y1="16" x2="12.01" y2="16" />
                                        </svg>
                                        <p>No complaints found</p>
                                    </div>
                                </div>
                                <% } else { %>
                                    <div class="card">
                                        <div class="card-header">
                                            <h3>Complaints (<%= complaints.length %>)</h3>
                                        </div>
                                        <div class="card-body">
                                            <div class="table-container">
                                                <table class="data-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Student</th>
                                                            <th>Room</th>
                                                            <th>Type</th>
                                                            <th>Description</th>
                                                            <th>Status</th>
                                                            <th>Date</th>
                                                            <th>Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% for (const c of complaints) { %>
                                                            <tr>
                                                                <td><strong>
                                                                        <%= c.full_name %>
                                                                    </strong><br><small class="text-muted">
                                                                        <%= c.student_id %>
                                                                    </small></td>
                                                                <td><span class="badge badge-outline">
                                                                        <%= c.room_number || 'N/A' %>
                                                                    </span></td>
                                                                <td><span class="pref-tag">
                                                                        <%= c.complaint_type %>
                                                                    </span></td>
                                                                <td style="max-width:250px;font-size:0.85rem;">
                                                                    <%= c.description %>
                                                                </td>
                                                                <td><span
                                                                        class="badge <%= c.status === 'Pending' ? 'badge-warning' : c.status === 'In Review' ? 'badge-info' : c.status === 'Resolved' ? 'badge-success' : 'badge-danger' %>">
                                                                        <%= c.status %>
                                                                    </span></td>
                                                                <td><small>
                                                                        <%= new
                                                                            Date(c.submitted_at).toLocaleDateString() %>
                                                                    </small></td>
                                                                <td>
                                                                    <% if (c.status !=='Resolved' && c.status
                                                                        !=='Rejected' ) { %>
                                                                        <form
                                                                            action="/admin/complaints/<%= c.id %>/update"
                                                                            method="POST"
                                                                            style="display:flex;flex-direction:column;gap:0.375rem;">
                                                                            <select name="status" class="form-control"
                                                                                style="font-size:0.78rem;padding:0.25rem 0.5rem;">
                                                                                <option value="Pending"
                                                                                    <%=c.status==='Pending' ? 'selected'
                                                                                    : '' %>>Pending</option>
                                                                                <option value="In Review"
                                                                                    <%=c.status==='In Review'
                                                                                    ? 'selected' : '' %>>In Review
                                                                                </option>
                                                                                <option value="Resolved">Resolved
                                                                                </option>
                                                                                <option value="Rejected">Rejected
                                                                                </option>
                                                                            </select>
                                                                            <input type="text" name="admin_notes"
                                                                                placeholder="Resolution notes..."
                                                                                class="form-control"
                                                                                style="font-size:0.75rem;padding:0.25rem 0.5rem;"
                                                                                value="<%= c.admin_notes || '' %>">
                                                                            <button type="submit"
                                                                                class="btn btn-primary btn-sm">Update</button>
                                                                        </form>
                                                                        <% } else { %>
                                                                            <small class="text-muted">
                                                                                <%= c.admin_notes || '—' %>
                                                                            </small>
                                                                            <% if (c.resolved_at) { %><br><small
                                                                                    class="text-muted">
                                                                                    <%= new
                                                                                        Date(c.resolved_at).toLocaleDateString()
                                                                                        %>
                                                                                </small>
                                                                                <% } %>
                                                                                    <% } %>
                                                                </td>
                                                            </tr>
                                                            <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                </div>
            </main>
    </div>
</body>

</html>