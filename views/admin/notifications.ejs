<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notifications - Admin Panel</title>
    <meta name="description" content="System notifications and alerts.">
    <link rel="stylesheet" href="/css/style.css?v=5">
</head>

<body>
    <div class="app-layout">
        <%- include('partials/sidebar') %>
            <main class="main-content">
                <div class="content-header">
                    <div>
                        <h1>Notifications</h1>
                        <div class="header-subtitle">System alerts and activity log</div>
                    </div>
                    <div class="content-header-actions">
                        <% if (unreadCount> 0) { %>
                            <button class="btn btn-outline btn-sm" onclick="markAllRead()">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                    <polyline points="22 4 12 14.01 9 11.01" />
                                </svg>
                                Mark All Read (<%= unreadCount %>)
                            </button>
                            <% } %>
                    </div>
                </div>
                <div class="content-body">
                    <% if (notifications.length===0) { %>
                        <div class="card">
                            <div class="card-body" style="text-align:center;padding:3rem;color:var(--slate-400);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="1.5"
                                    style="opacity:0.3;margin-bottom:1rem;">
                                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                                </svg>
                                <p>No notifications yet</p>
                            </div>
                        </div>
                        <% } else { %>
                            <div class="card">
                                <div class="card-body" style="padding:0;">
                                    <% for (const n of notifications) { %>
                                        <div class="notif-row <%= n.read_status === 0 ? 'unread' : '' %>"
                                            style="display:flex;align-items:flex-start;gap:0.875rem;padding:1rem 1.5rem;border-bottom:1px solid var(--slate-50);">
                                            <div class="notif-icon-dot"
                                                style="width:10px;height:10px;border-radius:50%;margin-top:0.35rem;flex-shrink:0;background:<%= n.type === 'success' ? 'var(--success)' : n.type === 'warning' ? 'var(--warning)' : n.type === 'error' ? 'var(--error)' : 'var(--info)' %>;">
                                            </div>
                                            <div style="flex:1;">
                                                <div
                                                    style="font-size:0.88rem;color:var(--slate-700);line-height:1.5;<%= n.read_status === 0 ? 'font-weight:600;' : '' %>">
                                                    <%= n.message %>
                                                </div>
                                                <div
                                                    style="font-size:0.75rem;color:var(--slate-400);margin-top:0.25rem;">
                                                    <%= new Date(n.created_at).toLocaleString() %>
                                                </div>
                                            </div>
                                            <% if (n.read_status===0) { %>
                                                <span class="badge badge-info" style="font-size:0.65rem;">NEW</span>
                                                <% } %>
                                        </div>
                                        <% } %>
                                </div>
                            </div>
                            <% } %>
                </div>
            </main>
    </div>
    <script>
        function markAllRead() {
            fetch('/admin/notifications/read', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
                .then(() => location.reload());
        }
    </script>
</body>

</html>