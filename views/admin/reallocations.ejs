<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reallocation Requests - Admin Panel</title>
    <meta name="description" content="Manage student room reallocation requests.">
    <link rel="stylesheet" href="/css/style.css?v=5">
</head>

<body>
    <div class="app-layout">
        <%- include('partials/sidebar') %>
            <main class="main-content">
                <div class="content-header">
                    <div>
                        <h1>Reallocation Requests</h1>
                        <div class="header-subtitle">Review and manage student room change requests</div>
                    </div>
                </div>
                <div class="content-body">
                    <% if (success) { %>
                        <div class="alert alert-success"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                <polyline points="22 4 12 14.01 9 11.01" />
                            </svg>
                            <%= success %>
                        </div>
                        <% } %>
                            <% if (error) { %>
                                <div class="alert alert-danger"><svg xmlns="http://www.w3.org/2000/svg" width="18"
                                        height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <circle cx="12" cy="12" r="10" />
                                        <line x1="15" y1="9" x2="9" y2="15" />
                                        <line x1="9" y1="9" x2="15" y2="15" />
                                    </svg>
                                    <%= error %>
                                </div>
                                <% } %>

                                    <% if (requests.length===0) { %>
                                        <div class="card">
                                            <div class="card-body"
                                                style="text-align:center;padding:3rem;color:var(--slate-400);">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48"
                                                    viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="1.5" style="opacity:0.3;margin-bottom:1rem;">
                                                    <polyline points="1 4 1 10 7 10" />
                                                    <polyline points="23 20 23 14 17 14" />
                                                    <path
                                                        d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15" />
                                                </svg>
                                                <p>No reallocation requests yet</p>
                                            </div>
                                        </div>
                                        <% } else { %>
                                            <div class="card">
                                                <div class="card-header">
                                                    <h3>All Requests (<%= requests.length %>)</h3>
                                                </div>
                                                <div class="card-body">
                                                    <div class="table-container">
                                                        <table class="data-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Student</th>
                                                                    <th>Room</th>
                                                                    <th>Reason</th>
                                                                    <th>Comments</th>
                                                                    <th>Status</th>
                                                                    <th>Date</th>
                                                                    <th>Actions</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% for (const r of requests) { %>
                                                                    <tr>
                                                                        <td><strong>
                                                                                <%= r.full_name %>
                                                                            </strong><br><small class="text-muted">
                                                                                <%= r.student_id %>
                                                                            </small></td>
                                                                        <td><span class="badge badge-outline">
                                                                                <%= r.room_number || 'N/A' %>
                                                                            </span></td>
                                                                        <td>
                                                                            <%= r.reason %>
                                                                        </td>
                                                                        <td style="max-width:200px;">
                                                                            <%= r.comments || '—' %>
                                                                        </td>
                                                                        <td>
                                                                            <span
                                                                                class="badge <%= r.status === 'Pending' ? 'badge-warning' : r.status === 'Approved' ? 'badge-success' : 'badge-danger' %>">
                                                                                <%= r.status %>
                                                                            </span>
                                                                        </td>
                                                                        <td><small>
                                                                                <%= new
                                                                                    Date(r.requested_at).toLocaleDateString()
                                                                                    %>
                                                                            </small></td>
                                                                        <td>
                                                                            <% if (r.status==='Pending' ) { %>
                                                                                <div
                                                                                    style="display:flex;gap:0.5rem;align-items:flex-start;flex-direction:column;">
                                                                                    <form
                                                                                        action="/admin/reallocations/<%= r.id %>/approve"
                                                                                        method="POST"
                                                                                        style="display:flex;gap:0.25rem;width:100%;">
                                                                                        <input type="text"
                                                                                            name="admin_notes"
                                                                                            placeholder="Notes..."
                                                                                            class="form-control"
                                                                                            style="font-size:0.75rem;padding:0.25rem 0.5rem;flex:1;">
                                                                                        <button type="submit"
                                                                                            class="btn btn-success btn-sm">Approve</button>
                                                                                    </form>
                                                                                    <form
                                                                                        action="/admin/reallocations/<%= r.id %>/reject"
                                                                                        method="POST"
                                                                                        style="display:flex;gap:0.25rem;width:100%;">
                                                                                        <input type="text"
                                                                                            name="admin_notes"
                                                                                            placeholder="Reason..."
                                                                                            class="form-control"
                                                                                            style="font-size:0.75rem;padding:0.25rem 0.5rem;flex:1;">
                                                                                        <button type="submit"
                                                                                            class="btn btn-danger btn-sm">Reject</button>
                                                                                    </form>
                                                                                </div>
                                                                                <% } else { %>
                                                                                    <small class="text-muted">
                                                                                        <%= r.admin_notes || '—' %>
                                                                                    </small>
                                                                                    <% if (r.reviewed_at) { %><br><small
                                                                                            class="text-muted">Reviewed:
                                                                                            <%= new
                                                                                                Date(r.reviewed_at).toLocaleDateString()
                                                                                                %></small>
                                                                                        <% } %>
                                                                                            <% } %>
                                                                        </td>
                                                                    </tr>
                                                                    <% } %>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                            <% } %>
                </div>
            </main>
    </div>
</body>

</html>