<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rooms - Admin Panel</title>
    <link rel="stylesheet" href="/css/style.css?v=4">
</head>

<body>
    <div class="app-layout">
        <%- include('partials/sidebar') %>

            <main class="main-content">
                <div class="content-header">
                    <div>
                        <h1>Room Management</h1>
                        <div class="header-subtitle">Manage hostel rooms and capacity</div>
                    </div>
                    <div class="content-header-actions">
                        <button class="btn btn-primary btn-sm" onclick="showAddRoomModal()">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="5" x2="12" y2="19" />
                                <line x1="5" y1="12" x2="19" y2="12" />
                            </svg>
                            Add Room
                        </button>
                    </div>
                </div>

                <div class="content-body">
                    <% if (success) { %>
                        <div class="alert alert-success">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                <polyline points="22 4 12 14.01 9 11.01" />
                            </svg>
                            <%= success %>
                        </div>
                        <% } %>
                            <% if (error) { %>
                                <div class="alert alert-danger">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10" />
                                        <line x1="15" y1="9" x2="9" y2="15" />
                                        <line x1="9" y1="9" x2="15" y2="15" />
                                    </svg>
                                    <%= error %>
                                </div>
                                <% } %>

                                    <!-- Room Stats Summary -->
                                    <div class="stats-grid">
                                        <div class="stat-card indigo">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Total Rooms</div>
                                                    <div class="stat-value">
                                                        <%= stats.totalRooms %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                                        <polyline points="9 22 9 12 15 12 15 22" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card green">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Available</div>
                                                    <div class="stat-value">
                                                        <%= rooms.filter(r=> r.status === 'Available').length %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                                        <polyline points="22 4 12 14.01 9 11.01" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card red">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Full</div>
                                                    <div class="stat-value">
                                                        <%= rooms.filter(r=> r.status !== 'Available').length %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="12" cy="12" r="10" />
                                                        <line x1="15" y1="9" x2="9" y2="15" />
                                                        <line x1="9" y1="9" x2="15" y2="15" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card purple">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Occupancy Rate</div>
                                                    <div class="stat-value">
                                                        <%= stats.occupancyRate %>%
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <line x1="18" y1="20" x2="18" y2="10" />
                                                        <line x1="12" y1="20" x2="12" y2="4" />
                                                        <line x1="6" y1="20" x2="6" y2="14" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Room Cards -->
                                    <div class="room-card-grid">
                                        <% rooms.forEach(function(r) { %>
                                            <div class="room-card" data-id="<%= r.id %>"
                                                onclick="openRoomDrawer(this.dataset.id)" style="cursor:pointer;">
                                                <div class="room-number">
                                                    <span>
                                                        <%= r.room_number %>
                                                    </span>
                                                    <span
                                                        class="badge <%= r.status === 'Available' ? 'badge-success' : 'badge-danger' %>">
                                                        <%= r.status %>
                                                    </span>
                                                </div>
                                                <div class="room-info">Capacity: <%= r.capacity %> students</div>
                                                <div class="room-info">Current Occupancy: <%= r.current_occupancy %>/<%=
                                                            r.capacity %>
                                                </div>
                                                <div style="margin-top:0.5rem;">
                                                    <div class="progress-bar-container">
                                                        <div class="progress-bar <%= r.current_occupancy >= r.capacity ? 'red' : r.current_occupancy > 0 ? 'green' : '' %>"
                                                            style="width: <%= r.capacity > 0 ? (r.current_occupancy / r.capacity) * 100 : 0 %>%">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="room-actions" onclick="event.stopPropagation()">
                                                    <button class="btn btn-sm btn-outline" data-id="<%= r.id %>"
                                                        data-num="<%= r.room_number %>" data-cap="<%= r.capacity %>"
                                                        onclick="editRoom(this.dataset.id, this.dataset.num, this.dataset.cap)">Edit</button>
                                                    <form action="/admin/rooms/<%= r.id %>/delete" method="POST"
                                                        style="display:inline;">
                                                        <button type="submit" class="btn btn-sm btn-outline"
                                                            style="color:var(--error);"
                                                            onclick="return confirm('Delete this room?')">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                            <% }); %>
                                    </div>

                                    <% if (rooms.length===0) { %>
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="empty-state">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2"
                                                        style="width:48px;height:48px;margin-bottom:1rem;color:var(--slate-300);">
                                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                                        <polyline points="9 22 9 12 15 12 15 22" />
                                                    </svg>
                                                    <h4>No rooms created</h4>
                                                    <p>Click "Add Room" to create your first room.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>
                </div>
            </main>
    </div>

    <!-- Room Details Drawer -->
    <div class="drawer-overlay" id="drawerOverlay" onclick="closeRoomDrawer()"></div>
    <div class="drawer" id="roomDrawer">
        <div class="drawer-header">
            <div style="display:flex; align-items:center; gap:1rem;">
                <h2 id="drawerRoomNumber" style="margin:0; font-size:1.5rem; font-weight:800; color:var(--slate-900);">
                    ---</h2>
                <span id="drawerRoomBadge" class="drawer-room-badge">---</span>
            </div>
            <button class="modal-close" onclick="closeRoomDrawer()">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div class="drawer-body" id="drawerBody">
            <div style="display:flex; justify-content:center; padding:3rem;">
                <div class="spinner"></div>
            </div>
        </div>
        <div class="drawer-footer">
            <button class="btn btn-outline btn-sm" style="flex:1;" onclick="closeRoomDrawer()">Close</button>
            <button class="btn btn-primary btn-sm" style="flex:1;" id="drawerNotifyRoomBtn">Notify All</button>
        </div>
    </div>

    <!-- Student Detail Modal (Secondary) -->
    <div class="modal-overlay" id="studentDetailModal" style="z-index:1100;">
        <div class="modal" style="max-width:500px;">
            <div class="modal-header">
                <h3>Student Profile</h3>
                <button class="modal-close" onclick="closeModal('studentDetailModal')">&times;</button>
            </div>
            <div class="modal-body" id="studentDetailBody"></div>
            <div class="modal-footer">
                <button class="btn btn-primary" onclick="closeModal('studentDetailModal')">Back to Room</button>
            </div>
        </div>
    </div>

    <!-- Add/Edit Room Modal -->
    <div class="modal-overlay" id="addRoomModal">
        <div class="modal">
            <div class="modal-header">
                <h3 id="roomModalTitle">Add New Room</h3>
                <button class="modal-close" onclick="closeModal('addRoomModal')">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>
            <form id="roomForm" action="/admin/rooms" method="POST">
                <div class="modal-body">
                    <div class="form-group">
                        <label for="room_number">Room Number</label>
                        <input type="text" id="room_number" name="room_number" class="form-control"
                            placeholder="e.g. A-101" required>
                    </div>
                    <div class="form-group">
                        <label for="capacity">Capacity</label>
                        <input type="number" id="capacity" name="capacity" class="form-control" min="1" max="10"
                            value="2" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" onclick="closeModal('addRoomModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="roomSubmitBtn">Add Room</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let currentRoomId = null;
        let cachedStudents = [];

        async function openRoomDrawer(roomId) {
            currentRoomId = roomId;
            const body = document.getElementById('drawerBody');
            document.getElementById('drawerOverlay').classList.add('active');
            document.getElementById('roomDrawer').classList.add('active');
            body.innerHTML = '<div style="display:flex; justify-content:center; padding:3rem;"><div class="spinner"></div></div>';
            try {
                const response = await fetch(`/admin/rooms/${roomId}/details`);
                const data = await response.json();
                if (data.error) throw new Error(data.error);
                cachedStudents = data.students;
                renderRoomDetails(data.room, data.students);
            } catch (err) {
                body.innerHTML = `<div class="alert alert-danger">${err.message || 'Failed to fetch details'}</div>`;
            }
        }

        function closeRoomDrawer() {
            document.getElementById('drawerOverlay').classList.remove('active');
            document.getElementById('roomDrawer').classList.remove('active');
            currentRoomId = null;
        }

        function renderRoomDetails(room, students) {
            document.getElementById('drawerRoomNumber').textContent = room.room_number;
            const badge = document.getElementById('drawerRoomBadge');
            badge.textContent = room.status;
            badge.className = 'drawer-room-badge ' + (room.status === 'Available' ? 'badge-success-light' : 'badge-danger-light');

            const remaining = room.capacity - room.current_occupancy;
            const progress = (room.current_occupancy / room.capacity) * 100;

            let html = `
                <div class="drawer-section">
                    <div class="drawer-section-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
                        Occupancy Overview
                    </div>
                    <div class="occupancy-summary"><span>Total Capacity</span><span class="val">${room.capacity}</span></div>
                    <div class="occupancy-summary"><span>Current Occupancy</span><span class="val">${room.current_occupancy}</span></div>
                    <div class="occupancy-summary"><span>Remaining Slots</span><span class="val" style="color:var(--${remaining > 0 ? 'success' : 'error'})">${remaining}</span></div>
                    <div class="progress-bar-container" style="height:8px; margin-top:1rem;">
                        <div class="progress-bar ${room.current_occupancy >= room.capacity ? 'red' : 'green'}" style="width:${progress}%"></div>
                    </div>
                </div>
                <div class="drawer-section">
                    <div class="drawer-section-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                        Assigned Students
                    </div>
            `;

            if (students.length === 0) {
                html += '<div style="padding:1.5rem; text-align:center; color:var(--slate-400); font-style:italic; font-size:0.9rem;">No students assigned yet.</div>';
            } else {
                students.forEach(s => {
                    const feeStatusClass = s.fee_status === 'Paid' ? 'badge-success-light' : s.fee_status === 'Overdue' ? 'badge-danger-light' : 'badge-warn-light';
                    html += `
                        <div class="student-list-card">
                            <div class="student-card-header">
                                <div><div class="student-card-name">${s.full_name}</div><div class="student-card-id">${s.student_id}</div></div>
                                <span class="badge ${feeStatusClass}">${s.fee_status || 'Pending'}</span>
                            </div>
                            <div class="student-card-grid" style="margin-bottom:1rem;">
                                <div class="student-card-info"><span class="student-card-label">Dept</span><span class="student-card-value">${s.department}</span></div>
                                <div class="student-card-info"><span class="student-card-label">Year</span><span class="student-card-value">Yr ${s.year}</span></div>
                            </div>
                            <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px dashed var(--slate-100); padding-top:0.75rem;">
                                ${s.compatibility_score ? `<div class="comp-badge">Match: ${s.compatibility_score}%</div>` : '<div></div>'}
                                <div class="student-card-actions" style="margin:0; padding:0; border:0; display:flex; gap:0.4rem;">
                                    <button class="btn btn-outline btn-xs" onclick="viewStudentProfile(${s.id})">Profile</button>
                                    <button class="btn btn-outline btn-xs" onclick="removeStudent(${s.id})">Remove</button>
                                    <button class="btn btn-outline btn-xs" onclick="showTransferModal(${s.id}, ${room.id})">Move</button>
                                </div>
                            </div>
                        </div>
                    `;
                });
            }
            html += '</div>';
            document.getElementById('drawerBody').innerHTML = html;
            document.getElementById('drawerNotifyRoomBtn').onclick = () => {
                const msg = prompt("Enter notification message for all students in this room:");
                if (msg) notifyRoom(room.id, msg);
            };
        }

        function viewStudentProfile(id) {
            const s = cachedStudents.find(x => x.id === id);
            if (!s) return;
            const body = document.getElementById('studentDetailBody');
            body.innerHTML = `
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;">
                    <div><label class="student-card-label">Full Name</label><div class="student-card-value">${s.full_name}</div></div>
                    <div><label class="student-card-label">Student ID</label><div class="student-card-value">${s.student_id}</div></div>
                    <div><label class="student-card-label">Department</label><div class="student-card-value">${s.department}</div></div>
                    <div><label class="student-card-label">Year</label><div class="student-card-value">Year ${s.year}</div></div>
                    <div><label class="student-card-label">Sleep Type</label><div class="student-card-value">${s.sleep_type || 'N/A'}</div></div>
                    <div><label class="student-card-label">Study Style</label><div class="student-card-value">${s.study_style || 'N/A'}</div></div>
                </div>
                <div style="margin-top:1.25rem; padding-top:1rem; border-top:1px solid var(--slate-100);">
                    <label class="student-card-label">Fee Status</label>
                    <div style="margin-top:0.4rem;"><span class="badge ${s.fee_status === 'Paid' ? 'badge-success-light' : 'badge-danger-light'}">${s.fee_status || 'Pending'}</span></div>
                </div>
            `;
            document.getElementById('studentDetailModal').classList.add('active');
        }

        async function removeStudent(studentId) {
            if (!confirm('Remove this student from room?')) return;
            try {
                const response = await fetch('/admin/rooms/remove-student', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ studentId, roomId: currentRoomId })
                });
                if ((await response.json()).success) openRoomDrawer(currentRoomId);
                else alert('Failed to remove');
            } catch (err) { alert('Error occurred'); }
        }

        async function showTransferModal(studentId, fromRoomId) {
            const targetRoomId = prompt("Enter target Room Number (e.g. A-102):");
            if (!targetRoomId) return;
            try {
                const response = await fetch('/admin/rooms/transfer-student', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ studentId, fromRoomId, toRoomId: targetRoomId })
                });
                const data = await response.json();
                if (data.success) {
                    alert('Transferred successfully');
                    location.reload();
                } else alert(data.error || 'Failed to transfer');
            } catch (err) { alert('Error occurred'); }
        }

        async function notifyRoom(roomId, message) {
            try {
                const response = await fetch('/admin/rooms/notify-room', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roomId, message })
                });
                if ((await response.json()).success) alert('Sent!');
                else alert('Failed');
            } catch (err) { alert('Error'); }
        }

        function showAddRoomModal() {
            document.getElementById('roomModalTitle').textContent = 'Add New Room';
            document.getElementById('roomForm').action = '/admin/rooms';
            document.getElementById('room_number').value = '';
            document.getElementById('capacity').value = '2';
            document.getElementById('roomSubmitBtn').textContent = 'Add Room';
            document.getElementById('addRoomModal').classList.add('active');
        }

        function editRoom(id, number, capacity) {
            document.getElementById('roomModalTitle').textContent = 'Edit Room';
            document.getElementById('roomForm').action = '/admin/rooms/' + id + '/edit';
            document.getElementById('room_number').value = number;
            document.getElementById('capacity').value = capacity;
            document.getElementById('roomSubmitBtn').textContent = 'Update Room';
            document.getElementById('addRoomModal').classList.add('active');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        document.querySelectorAll('.modal-overlay:not(#drawerOverlay)').forEach(modal => {
            modal.addEventListener('click', function (e) {
                if (e.target === this) this.classList.remove('active');
            });
        });
    </script>
</body>

</html>