<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Smart Hostel</title>
    <meta name="description"
        content="Admin dashboard for Smart Hostel Room Allocation System - manage students, rooms, and allocations.">
    <link rel="stylesheet" href="/css/style.css?v=4">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>

<body>
    <div class="app-layout">
        <!-- Mobile Toggle -->
        <button class="mobile-toggle" onclick="toggleSidebar()">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
        </button>
        <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

        <!-- ═══════════════════════════════════════
         SIDEBAR
         ═══════════════════════════════════════ -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-brand">
                    <div class="brand-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                            <polyline points="9 22 9 12 15 12 15 22" />
                        </svg>
                    </div>
                    <div class="brand-text">
                        <h2>Smart Hostel</h2>
                        <span>Admin Panel</span>
                    </div>
                </div>
            </div>

            <div class="sidebar-user">
                <div class="user-info">
                    <div class="user-avatar">
                        <%= currentUser.fullName ? currentUser.fullName.charAt(0).toUpperCase() : 'A' %>
                    </div>
                    <div class="user-details">
                        <div class="user-name">
                            <%= currentUser.fullName %>
                        </div>
                        <div class="user-role">Administrator</div>
                    </div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-title">Main Menu</div>
                <a href="#" class="nav-item active" onclick="showTab('overview')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                    </svg>
                    Dashboard
                </a>
                <a href="#" class="nav-item" onclick="showTab('students')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    Students
                    <span class="nav-badge">
                        <%= stats.totalStudents %>
                    </span>
                </a>
                <a href="#" class="nav-item" onclick="showTab('rooms')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    Rooms
                    <span class="nav-badge">
                        <%= stats.totalRooms %>
                    </span>
                </a>
                <a href="#" class="nav-item" onclick="showTab('allocation')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 3 21 3 21 8" />
                        <line x1="4" y1="20" x2="21" y2="3" />
                        <polyline points="21 16 21 21 16 21" />
                        <line x1="15" y1="15" x2="21" y2="21" />
                        <line x1="4" y1="4" x2="9" y2="9" />
                    </svg>
                    Allocation
                </a>
                <a href="#" class="nav-item" onclick="showTab('reports')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                        <polyline points="10 9 9 9 8 9" />
                    </svg>
                    Reports
                </a>

                <div class="nav-section-title" style="margin-top:0.75rem;">System</div>
                <a href="/admin/announcements" class="nav-item <%= activePage === 'announcements' ? 'active' : '' %>">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                    </svg>
                    Announcements
                </a>
                <a href="#" class="nav-item" onclick="showTab('allocation')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3" />
                        <path
                            d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                    </svg>
                    Settings
                </a>
            </nav>

            <div class="sidebar-footer">
                <a href="/logout" class="nav-item">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>
                    Logout
                </a>
            </div>
        </aside>

        <!-- ═══════════════════════════════════════
         MAIN CONTENT AREA
         ═══════════════════════════════════════ -->
        <main class="main-content">
            <div class="content-header">
                <div>
                    <h1 id="pageTitle">Dashboard Overview</h1>
                    <div class="header-subtitle">Manage hostel room allocations</div>
                </div>
                <div class="content-header-actions">
                    <a href="/admin/export" class="btn btn-outline btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                            <polyline points="7 10 12 15 17 10" />
                            <line x1="12" y1="15" x2="12" y2="3" />
                        </svg>
                        Export CSV
                    </a>
                </div>
            </div>

            <div class="content-body">
                <!-- Alerts -->
                <% if (success) { %>
                    <div class="alert alert-success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                            <polyline points="22 4 12 14.01 9 11.01" />
                        </svg>
                        <%= success %>
                    </div>
                    <% } %>
                        <% if (error) { %>
                            <div class="alert alert-danger">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10" />
                                    <line x1="15" y1="9" x2="9" y2="15" />
                                    <line x1="9" y1="9" x2="15" y2="15" />
                                </svg>
                                <%= error %>
                            </div>
                            <% } %>

                                <!-- ═══ OVERVIEW TAB ═══ -->
                                <div class="tab-content active" id="tab-overview">
                                    <!-- Stats Grid -->
                                    <div class="stats-grid">
                                        <div class="stat-card blue">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Total Students</div>
                                                    <div class="stat-value">
                                                        <%= stats.totalStudents %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                                        <circle cx="9" cy="7" r="4" />
                                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card indigo">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Total Rooms</div>
                                                    <div class="stat-value">
                                                        <%= stats.totalRooms %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                                        <polyline points="9 22 9 12 15 12 15 22" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card green">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Allocated</div>
                                                    <div class="stat-value">
                                                        <%= stats.allocatedStudents %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                                        <polyline points="22 4 12 14.01 9 11.01" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card yellow">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Pending</div>
                                                    <div class="stat-value">
                                                        <%= stats.pendingStudents %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="12" cy="12" r="10" />
                                                        <polyline points="12 6 12 12 16 14" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card purple">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Avg Compatibility</div>
                                                    <div class="stat-value">
                                                        <%= stats.avgCompatibility %>
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <polygon
                                                            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="stat-card red">
                                            <div class="stat-header">
                                                <div>
                                                    <div class="stat-label">Occupancy Rate</div>
                                                    <div class="stat-value">
                                                        <%= stats.occupancyRate %>%
                                                    </div>
                                                </div>
                                                <div class="stat-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <line x1="18" y1="20" x2="18" y2="10" />
                                                        <line x1="12" y1="20" x2="12" y2="4" />
                                                        <line x1="6" y1="20" x2="6" y2="14" />
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Charts Row -->
                                    <div class="grid-2">
                                        <div class="card">
                                            <div class="card-header">
                                                <h3>
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2">
                                                        <line x1="18" y1="20" x2="18" y2="10" />
                                                        <line x1="12" y1="20" x2="12" y2="4" />
                                                        <line x1="6" y1="20" x2="6" y2="14" />
                                                    </svg>
                                                    Department Distribution
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <canvas id="deptChart" height="220"></canvas>
                                            </div>
                                        </div>
                                        <div class="card">
                                            <div class="card-header">
                                                <h3>
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2">
                                                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                                                    </svg>
                                                    Allocation Overview
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <canvas id="allocChart" height="220"></canvas>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Quick Allocation Control -->
                                    <div class="control-panel">
                                        <h3>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                style="display:inline; vertical-align:middle; margin-right:6px;">
                                                <polyline points="16 3 21 3 21 8" />
                                                <line x1="4" y1="20" x2="21" y2="3" />
                                                <polyline points="21 16 21 21 16 21" />
                                                <line x1="15" y1="15" x2="21" y2="21" />
                                                <line x1="4" y1="4" x2="9" y2="9" />
                                            </svg>
                                            Quick Allocation Controls
                                        </h3>
                                        <p>Run the greedy allocation algorithm to assign students to rooms based on
                                            compatibility scoring.</p>
                                        <div class="control-buttons">
                                            <form action="/admin/allocate" method="POST" style="display:inline;">
                                                <button type="submit" class="btn btn-success"
                                                    onclick="return confirm('Run allocation algorithm? This will assign pending students to available rooms.')">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2">
                                                        <polygon points="5 3 19 12 5 21 5 3" />
                                                    </svg>
                                                    Run Allocation
                                                </button>
                                            </form>
                                            <form action="/admin/reset-allocation" method="POST"
                                                style="display:inline;">
                                                <button type="submit" class="btn btn-danger"
                                                    onclick="return confirm('⚠️ This will remove ALL allocations. Are you sure?')">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2">
                                                        <polyline points="1 4 1 10 7 10" />
                                                        <polyline points="23 20 23 14 17 14" />
                                                        <path
                                                            d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15" />
                                                    </svg>
                                                    Reset All Allocations
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- ═══ STUDENTS TAB ═══ -->
                                <div class="tab-content" id="tab-students">
                                    <div class="section-header">
                                        <h2>
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                                <circle cx="9" cy="7" r="4" />
                                                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                            </svg>
                                            Student Management
                                        </h2>
                                    </div>

                                    <div class="card">
                                        <div class="card-header">
                                            <div class="search-bar" style="width:100%;">
                                                <div class="search-input-wrapper">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="11" cy="11" r="8" />
                                                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                                                    </svg>
                                                    <input type="text" id="studentSearch"
                                                        placeholder="Search by name, ID, or department..."
                                                        oninput="filterStudents()">
                                                </div>
                                                <select class="filter-select" id="deptFilter"
                                                    onchange="filterStudents()">
                                                    <option value="">All Departments</option>
                                                    <% departments.forEach(function(d) { %>
                                                        <option value="<%= d.department %>">
                                                            <%= d.department %>
                                                        </option>
                                                        <% }); %>
                                                </select>
                                                <select class="filter-select" id="statusFilter"
                                                    onchange="filterStudents()">
                                                    <option value="">All Status</option>
                                                    <option value="Allocated">Allocated</option>
                                                    <option value="Pending">Pending</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="table-container">
                                            <table class="data-table" id="studentsTable">
                                                <thead>
                                                    <tr>
                                                        <th>Student ID</th>
                                                        <th>Full Name</th>
                                                        <th>Department</th>
                                                        <th>Year</th>
                                                        <th>Email</th>
                                                        <th>Preferences</th>
                                                        <th>Status</th>
                                                        <th>Room</th>
                                                        <th>Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% students.forEach(function(s) { %>
                                                        <tr data-dept="<%= s.department %>"
                                                            data-status="<%= s.allocation_status %>"
                                                            data-search="<%= s.student_id %> <%= s.full_name %> <%= s.department %>">
                                                            <td><strong>
                                                                    <%= s.student_id %>
                                                                </strong></td>
                                                            <td>
                                                                <%= s.full_name %>
                                                            </td>
                                                            <td>
                                                                <%= s.department %>
                                                            </td>
                                                            <td>Year <%= s.year %>
                                                            </td>
                                                            <td class="text-sm text-muted">
                                                                <%= s.email %>
                                                            </td>
                                                            <td>
                                                                <% if (s.sleep_type) { %>
                                                                    <span class="pref-tag">
                                                                        <%= s.sleep_type %>
                                                                    </span>
                                                                    <span class="pref-tag">
                                                                        <%= s.study_style %>
                                                                    </span>
                                                                    <% } else { %>
                                                                        <span class="text-muted text-sm">Not set</span>
                                                                        <% } %>
                                                            </td>
                                                            <td>
                                                                <span
                                                                    class="badge <%= s.allocation_status === 'Allocated' ? 'badge-success' : 'badge-warning' %>">
                                                                    <%= s.allocation_status %>
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <%= s.room_number || '—' %>
                                                            </td>
                                                            <td>
                                                                <div style="display:flex; gap:4px;">
                                                                    <button class="btn btn-icon btn-outline"
                                                                        title="View Preferences"
                                                                        onclick="viewPreferences(<%= s.id %>)">
                                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                                            width="16" height="16" viewBox="0 0 24 24"
                                                                            fill="none" stroke="currentColor"
                                                                            stroke-width="2">
                                                                            <path
                                                                                d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                                                            <circle cx="12" cy="12" r="3" />
                                                                        </svg>
                                                                    </button>
                                                                    <form action="/admin/students/<%= s.id %>/delete"
                                                                        method="POST" style="display:inline;">
                                                                        <button type="submit"
                                                                            class="btn btn-icon btn-outline"
                                                                            title="Delete"
                                                                            onclick="return confirm('Delete this student?')"
                                                                            style="color:var(--error);">
                                                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                                                width="16" height="16"
                                                                                viewBox="0 0 24 24" fill="none"
                                                                                stroke="currentColor" stroke-width="2">
                                                                                <polyline points="3 6 5 6 21 6" />
                                                                                <path
                                                                                    d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                                                            </svg>
                                                                        </button>
                                                                    </form>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
                                        <% if (students.length===0) { %>
                                            <div class="empty-state">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                                    <circle cx="9" cy="7" r="4" />
                                                </svg>
                                                <h4>No students registered</h4>
                                                <p>Students will appear here after they register.</p>
                                            </div>
                                            <% } %>
                                    </div>
                                </div>

                                <!-- ═══ ROOMS TAB ═══ -->
                                <div class="tab-content" id="tab-rooms">
                                    <div class="section-header">
                                        <h2>
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                                <polyline points="9 22 9 12 15 12 15 22" />
                                            </svg>
                                            Room Management
                                        </h2>
                                        <button class="btn btn-primary btn-sm" onclick="showAddRoomModal()">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <line x1="12" y1="5" x2="12" y2="19" />
                                                <line x1="5" y1="12" x2="19" y2="12" />
                                            </svg>
                                            Add Room
                                        </button>
                                    </div>

                                    <div class="room-card-grid">
                                        <% rooms.forEach(function(r) { %>
                                            <div class="room-card">
                                                <div class="room-number">
                                                    <span>
                                                        <%= r.room_number %>
                                                    </span>
                                                    <span
                                                        class="badge <%= r.status === 'Available' ? 'badge-success' : 'badge-danger' %>">
                                                        <%= r.status %>
                                                    </span>
                                                </div>
                                                <div class="room-info">Capacity: <%= r.capacity %> students</div>
                                                <div class="room-info">Current Occupancy: <%= r.current_occupancy %>/<%=
                                                            r.capacity %>
                                                </div>
                                                <div style="margin-top:0.5rem;">
                                                    <div class="progress-bar-container">
                                                        <div class="progress-bar <%= r.current_occupancy >= r.capacity ? 'red' : r.current_occupancy > 0 ? 'green' : '' %>"
                                                            style="width: <%= r.capacity > 0 ? (r.current_occupancy / r.capacity) * 100 : 0 %>%">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="room-actions">
                                                    <button class="btn btn-sm btn-outline"
                                                        onclick="editRoom(<%= r.id %>, '<%= r.room_number %>', <%= r.capacity %>)">Edit</button>
                                                    <form action="/admin/rooms/<%= r.id %>/delete" method="POST"
                                                        style="display:inline;">
                                                        <button type="submit" class="btn btn-sm btn-outline"
                                                            style="color:var(--error);"
                                                            onclick="return confirm('Delete this room?')">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                            <% }); %>
                                    </div>

                                    <% if (rooms.length===0) { %>
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="empty-state">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                                        fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                                        <polyline points="9 22 9 12 15 12 15 22" />
                                                    </svg>
                                                    <h4>No rooms created</h4>
                                                    <p>Click "Add Room" to create your first room.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>
                                </div>

                                <!-- ═══ ALLOCATION TAB ═══ -->
                                <div class="tab-content" id="tab-allocation">
                                    <div class="section-header">
                                        <h2>
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <polyline points="16 3 21 3 21 8" />
                                                <line x1="4" y1="20" x2="21" y2="3" />
                                            </svg>
                                            Allocation Control
                                        </h2>
                                    </div>

                                    <div class="control-panel">
                                        <h3>Run Allocation Engine</h3>
                                        <p>The greedy algorithm will assign each pending student to the most compatible
                                            available room. Students with conflicts will not be placed together.</p>
                                        <div class="control-buttons">
                                            <form action="/admin/allocate" method="POST" style="display:inline;">
                                                <button type="submit" class="btn btn-success btn-lg"
                                                    onclick="return confirm('Run the allocation algorithm?')">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2">
                                                        <polygon points="5 3 19 12 5 21 5 3" />
                                                    </svg>
                                                    Run Allocation
                                                </button>
                                            </form>
                                            <form action="/admin/reset-allocation" method="POST"
                                                style="display:inline;">
                                                <button type="submit" class="btn btn-danger btn-lg"
                                                    onclick="return confirm('⚠️ Reset ALL allocations?')">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2">
                                                        <polyline points="1 4 1 10 7 10" />
                                                        <polyline points="23 20 23 14 17 14" />
                                                        <path
                                                            d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15" />
                                                    </svg>
                                                    Reset All Allocations
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                    <div class="grid-2">
                                        <div class="card">
                                            <div class="card-header">
                                                <h3>
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2">
                                                        <line x1="18" y1="20" x2="18" y2="10" />
                                                        <line x1="12" y1="20" x2="12" y2="4" />
                                                        <line x1="6" y1="20" x2="6" y2="14" />
                                                    </svg>
                                                    Allocation Stats
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div class="detail-item">
                                                    <span class="detail-label">Allocated Students</span>
                                                    <span class="detail-value">
                                                        <%= stats.allocatedStudents %>
                                                    </span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-label">Pending Students</span>
                                                    <span class="detail-value">
                                                        <%= stats.pendingStudents %>
                                                    </span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-label">Avg Compatibility</span>
                                                    <span class="detail-value">
                                                        <%= stats.avgCompatibility %>
                                                    </span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-label">Occupancy Rate</span>
                                                    <span class="detail-value">
                                                        <%= stats.occupancyRate %>%
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card">
                                            <div class="card-header">
                                                <h3>
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2">
                                                        <polygon
                                                            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                                    </svg>
                                                    Scoring Rules
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div class="detail-item">
                                                    <span class="detail-label">Same Sleep Type</span>
                                                    <span class="badge badge-success">+3</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-label">Same Study Style</span>
                                                    <span class="badge badge-success">+2</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-label">Same Department</span>
                                                    <span class="badge badge-success">+2</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-label">Preferred Roommate</span>
                                                    <span class="badge badge-info">+5</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-label">Conflict Detected</span>
                                                    <span class="badge badge-danger">−10</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- ═══ REPORTS TAB ═══ -->
                                <div class="tab-content" id="tab-reports">
                                    <div class="section-header">
                                        <h2>
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                                <polyline points="14 2 14 8 20 8" />
                                            </svg>
                                            Allocation Report
                                        </h2>
                                        <a href="/admin/export" class="btn btn-primary btn-sm">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                                <polyline points="7 10 12 15 17 10" />
                                                <line x1="12" y1="15" x2="12" y2="3" />
                                            </svg>
                                            Export CSV
                                        </a>
                                    </div>

                                    <div class="card">
                                        <div class="table-container">
                                            <table class="data-table">
                                                <thead>
                                                    <tr>
                                                        <th>Student ID</th>
                                                        <th>Name</th>
                                                        <th>Department</th>
                                                        <th>Room</th>
                                                        <th>Compatibility</th>
                                                        <th>Allocated At</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% allocations.forEach(function(a) { %>
                                                        <tr>
                                                            <td><strong>
                                                                    <%= a.student_id %>
                                                                </strong></td>
                                                            <td>
                                                                <%= a.full_name %>
                                                            </td>
                                                            <td>
                                                                <%= a.department %>
                                                            </td>
                                                            <td><span class="badge badge-primary">
                                                                    <%= a.room_number %>
                                                                </span></td>
                                                            <td>
                                                                <%= a.compatibility_score !=null ?
                                                                    a.compatibility_score.toFixed(1) : '0' %>
                                                            </td>
                                                            <td class="text-sm text-muted">
                                                                <%= new Date(a.allocated_at).toLocaleDateString('en-IN',
                                                                    { day:'numeric', month:'short', year:'numeric' }) %>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
                                        <% if (allocations.length===0) { %>
                                            <div class="empty-state">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <path
                                                        d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                                    <polyline points="14 2 14 8 20 8" />
                                                </svg>
                                                <h4>No allocations yet</h4>
                                                <p>Run the allocation engine to assign students to rooms.</p>
                                            </div>
                                            <% } %>
                                    </div>
                                </div>
            </div>
        </main>
    </div>

    <!-- Add Room Modal -->
    <div class="modal-overlay" id="addRoomModal">
        <div class="modal">
            <div class="modal-header">
                <h3 id="roomModalTitle">Add New Room</h3>
                <button class="modal-close" onclick="closeModal('addRoomModal')">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>
            <form id="roomForm" action="/admin/rooms" method="POST">
                <div class="modal-body">
                    <div class="form-group">
                        <label for="room_number">Room Number</label>
                        <input type="text" id="room_number" name="room_number" class="form-control"
                            placeholder="e.g. A-101" required>
                    </div>
                    <div class="form-group">
                        <label for="capacity">Capacity</label>
                        <input type="number" id="capacity" name="capacity" class="form-control" min="1" max="10"
                            value="2" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" onclick="closeModal('addRoomModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="roomSubmitBtn">Add Room</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Preferences Modal -->
    <div class="modal-overlay" id="prefsModal">
        <div class="modal">
            <div class="modal-header">
                <h3>Student Preferences</h3>
                <button class="modal-close" onclick="closeModal('prefsModal')">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>
            <div class="modal-body" id="prefsModalBody">
                <p class="text-muted">Loading...</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeModal('prefsModal')">Close</button>
            </div>
        </div>
    </div>

    <script>
        // Tab navigation
        function showTab(tab) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            document.getElementById('tab-' + tab).classList.add('active');
            event.currentTarget.classList.add('active');

            const titles = {
                overview: 'Dashboard Overview',
                students: 'Student Management',
                rooms: 'Room Management',
                allocation: 'Allocation Control',
                reports: 'Reports'
            };
            document.getElementById('pageTitle').textContent = titles[tab] || 'Dashboard';
        }

        // Sidebar toggle
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.querySelector('.sidebar-overlay').classList.toggle('active');
        }

        // Filter students
        function filterStudents() {
            const search = document.getElementById('studentSearch').value.toLowerCase();
            const dept = document.getElementById('deptFilter').value;
            const status = document.getElementById('statusFilter').value;

            document.querySelectorAll('#studentsTable tbody tr').forEach(row => {
                const matchSearch = !search || row.dataset.search.toLowerCase().includes(search);
                const matchDept = !dept || row.dataset.dept === dept;
                const matchStatus = !status || row.dataset.status === status;
                row.style.display = matchSearch && matchDept && matchStatus ? '' : 'none';
            });
        }

        // Room Modal
        function showAddRoomModal() {
            document.getElementById('roomModalTitle').textContent = 'Add New Room';
            document.getElementById('roomForm').action = '/admin/rooms';
            document.getElementById('room_number').value = '';
            document.getElementById('capacity').value = '2';
            document.getElementById('roomSubmitBtn').textContent = 'Add Room';
            document.getElementById('addRoomModal').classList.add('active');
        }

        function editRoom(id, number, capacity) {
            document.getElementById('roomModalTitle').textContent = 'Edit Room';
            document.getElementById('roomForm').action = '/admin/rooms/' + id + '/edit';
            document.getElementById('room_number').value = number;
            document.getElementById('capacity').value = capacity;
            document.getElementById('roomSubmitBtn').textContent = 'Update Room';
            document.getElementById('addRoomModal').classList.add('active');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        // Close modal on overlay click
        document.querySelectorAll('.modal-overlay').forEach(modal => {
            modal.addEventListener('click', function (e) {
                if (e.target === this) this.classList.remove('active');
            });
        });

        // View preferences
        async function viewPreferences(studentId) {
            document.getElementById('prefsModalBody').innerHTML = '<p class="text-muted">Loading...</p>';
            document.getElementById('prefsModal').classList.add('active');

            try {
                const res = await fetch('/admin/students/' + studentId + '/preferences');
                const data = await res.json();

                let html = '<div class="detail-item"><span class="detail-label">Name</span><span class="detail-value">' + (data.full_name || 'N/A') + '</span></div>';
                html += '<div class="detail-item"><span class="detail-label">Student ID</span><span class="detail-value">' + (data.student_id || 'N/A') + '</span></div>';
                html += '<div class="detail-item"><span class="detail-label">Department</span><span class="detail-value">' + (data.department || 'N/A') + '</span></div>';
                html += '<div class="detail-item"><span class="detail-label">Sleep Type</span><span class="pref-tag">' + (data.sleep_type || 'Not set') + '</span></div>';
                html += '<div class="detail-item"><span class="detail-label">Study Style</span><span class="pref-tag">' + (data.study_style || 'Not set') + '</span></div>';
                html += '<div class="detail-item"><span class="detail-label">Noise Tolerance</span><span class="pref-tag">' + (data.noise_tolerance || 'Not set') + '</span></div>';
                html += '<div class="detail-item"><span class="detail-label">Cleanliness</span><span class="pref-tag">' + (data.cleanliness_level || 'Not set') + '</span></div>';
                html += '<div class="detail-item"><span class="detail-label">Preferred Roommate</span><span class="detail-value">' + (data.preferred_roommate || 'None') + '</span></div>';
                html += '<div class="detail-item"><span class="detail-label">Conflicts</span><span class="detail-value">' + (data.conflict_list || 'None') + '</span></div>';

                document.getElementById('prefsModalBody').innerHTML = html;
            } catch (err) {
                document.getElementById('prefsModalBody').innerHTML = '<p class="text-danger">Failed to load preferences.</p>';
            }
        }

        // Charts
        const deptData = <% - JSON.stringify(departments) %>;
        const allocData = { allocated: <%= stats.allocatedStudents %>, pending: <%= stats.pendingStudents %> };

        if (deptData.length > 0) {
            new Chart(document.getElementById('deptChart'), {
                type: 'bar',
                data: {
                    labels: deptData.map(d => d.department),
                    datasets: [{
                        label: 'Students',
                        data: deptData.map(d => d.count),
                        backgroundColor: ['#6366f1', '#818cf8', '#a5b4fc', '#c7d2fe', '#e0e7ff', '#8b5cf6'],
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f1f5f9' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        new Chart(document.getElementById('allocChart'), {
            type: 'doughnut',
            data: {
                labels: ['Allocated', 'Pending'],
                datasets: [{
                    data: [allocData.allocated, allocData.pending],
                    backgroundColor: ['#22c55e', '#f59e0b'],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                cutout: '65%',
                plugins: {
                    legend: { position: 'bottom', labels: { padding: 20, usePointStyle: true } }
                }
            }
        });
    </script>
</body>

</html>