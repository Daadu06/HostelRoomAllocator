{
    "version": 2,
    "builds": [
        {
            "src": "server-combined.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/css/(.*)",
            "dest": "/public/css/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/server-combined.js"
        }
    ]
}